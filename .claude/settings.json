{
    "permissions": {
        "defaultMode": "acceptEdits",
        "blockWritesOutsideWorkingDirectories": true,
        "allow": [
            "Edit(/src/**)",
            "Edit(/docs/**)",
            "Edit(/.claude/**)",
            "Edit(/.vscode/**)",
            "Edit(/Cargo.toml)",
            "Edit(/Cargo.lock)",
            "Edit(/CLAUDE.md)",
            "Edit(/README.md)",
            "Edit(/.gitignore)",
            "Bash(cargo build:*)",
            "Bash(cargo check:*)",
            "Bash(cargo test:*)",
            "Bash(cargo run:*)",
            "Bash(cargo fmt:*)",
            "Bash(cargo clippy:*)",
            "Bash(cargo doc:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Bash(rm -rf:*)",
            "Bash(git push:*)",
            "Bash(git reset --hard:*)"
        ]
    }
}